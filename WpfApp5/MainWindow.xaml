<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="Slot Machine" Height="650" Width="1000">
    <Grid Background="#FF222222">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Orientation="Horizontal">
            <TextBlock x:Name="txtEgyenleg" Text="Egyenleg: 100 kredit" Foreground="Gold" FontSize="24" FontWeight="Bold" Margin="0,0,40,0"/>
            <TextBlock x:Name="txtEredmeny" Text="" Foreground="White" FontSize="24" FontWeight="Bold" Width="300" TextAlignment="Center"/>
        </StackPanel>

        <Grid ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Top" Width="600" Height="450" Margin="0,80,0,0" Background="#FF111111">

            <Canvas x:Name="tarcsa1" Width="200" HorizontalAlignment="Left">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="trans1" Y="0"/>
                </Canvas.RenderTransform>
            </Canvas>

            <Canvas x:Name="tarcsa2" Width="200" HorizontalAlignment="Left" Margin="200,0,0,0">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="trans2" Y="0"/>
                </Canvas.RenderTransform>
            </Canvas>

            <Canvas x:Name="tarcsa3" Width="200" HorizontalAlignment="Left" Margin="400,0,0,0">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="trans3" Y="0"/>
                </Canvas.RenderTransform>
            </Canvas>

            <Line X1="0" Y1="225" X2="600" Y2="225" Stroke="Red" StrokeThickness="5" Opacity="0.85" VerticalAlignment="Top"/>
        </Grid>

        <Rectangle Height="450" Stroke="Gold" Width="600" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" IsHitTestVisible="False"/>

        <Button x:Name="gold" Content="PÖRGETÉS (10)" HorizontalAlignment="Center" Margin="0,550,0,0" VerticalAlignment="Top" Height="50" Width="180" Background="Gold" FontSize="18" FontWeight="Bold" Foreground="Black" Click="gold_Click"/>
    </Grid>
</Window>